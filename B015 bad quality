        "\n",
        "import numpy as np\n",
        "import scipy.io\n",
        "import pywt\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import mean_squared_error\n",
        "import gc\n",
        "import warnings\n",
        "from scipy.ndimage import zoom, rotate\n",
        "import os\n",
        "import glob\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "print(\"=== PIPELINE PINNS KELVIN-HELMHOLTZ (GOOGLE DRIVE) ===\")\n",
        "\n",
        "# MONTER GOOGLE DRIVE\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "def calculate_psnr(img1, img2, max_val=None):\n",
        "    \"\"\"Calcule le PSNR entre deux images\"\"\"\n",
        "    if max_val is None:\n",
        "        max_val = max(img1.max(), img2.max()) - min(img1.min(), img2.min())\n",
        "\n",
        "    mse = np.mean((img1 - img2) ** 2)\n",
        "    if mse == 0:\n",
        "        return float('inf')\n",
        "\n",
        "    psnr = 20 * np.log10(max_val / np.sqrt(mse))\n",
        "    return psnr\n",
        "\n",
        "def calculate_ssim_simple(img1, img2):\n",
        "    \"\"\"Version simplifiée du SSIM\"\"\"\n",
        "    mu1 = np.mean(img1)\n",
        "    mu2 = np.mean(img2)\n",
        "\n",
        "    sigma1_sq = np.var(img1)\n",
        "    sigma2_sq = np.var(img2)\n",
        "    sigma12 = np.mean((img1 - mu1) * (img2 - mu2))\n",
        "\n",
        "    c1 = 0.01 ** 2\n",
        "    c2 = 0.03 ** 2\n",
        "\n",
        "    ssim = ((2 * mu1 * mu2 + c1) * (2 * sigma12 + c2)) / \\\n",
        "           ((mu1**2 + mu2**2 + c1) * (sigma1_sq + sigma2_sq + c2))\n",
        "\n",
        "    return ssim\n",
        "\n",
        "def dwt_transform_gdrive(data, wavelet='coif2', levels=1):\n",
        "    \"\"\"Transformée en ondelettes optimisée\"\"\"\n",
        "    if data.shape[0] > 256:\n",
        "        # Sous-échantillonnage par moyennage\n",
        "        h, w = data.shape\n",
        "        new_h, new_w = h//2, w//2\n",
        "        data_resized = np.zeros((new_h, new_w), dtype=np.float32)\n",
        "\n",
        "        for i in range(new_h):\n",
        "            for j in range(new_w):\n",
        "                data_resized[i, j] = np.mean(data[2*i:2*i+2, 2*j:2*j+2])\n",
        "\n",
        "        data = data_resized\n",
        "\n",
        "    coeffs = pywt.wavedec2(data, wavelet, level=levels)\n",
        "    coeffs_flat = []\n",
        "    for i, coeff in enumerate(coeffs):\n",
        "        if i == 0:\n",
        "            coeffs_flat.append(coeff.flatten())\n",
        "        else:\n",
        "            for detail in coeff:\n",
        "                coeffs_flat.append(detail.flatten())\n",
        "    return np.concatenate(coeffs_flat)\n",
        "\n",
        "def idwt_transform_gdrive(coeffs_flat, original_shape, wavelet='coif2', levels=1):\n",
        "    \"\"\"Transformée inverse optimisée\"\"\"\n",
        "    if original_shape[0] > 256:\n",
        "        work_shape = (original_shape[0]//2, original_shape[1]//2)\n",
        "    else:\n",
        "        work_shape = original_shape\n",
        "\n",
        "    coeffs = []\n",
        "    idx = 0\n",
        "\n",
        "    # Calculer les tailles\n",
        "    sizes = []\n",
        "    current_shape = work_shape\n",
        "    for i in range(levels + 1):\n",
        "        sizes.append(current_shape)\n",
        "        if i < levels:\n",
        "            current_shape = tuple(s // 2 for s in current_shape)\n",
        "\n",
        "    # Approximation\n",
        "    size = sizes[-1]\n",
        "    length = size[0] * size[1]\n",
        "    coeffs.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "    idx += length\n",
        "\n",
        "    # Détails\n",
        "    for i in range(levels-1, -1, -1):\n",
        "        size = sizes[i+1] if i+1 < len(sizes) else sizes[-1]\n",
        "        length = size[0] * size[1]\n",
        "        details = []\n",
        "        for _ in range(3):\n",
        "            if idx + length <= len(coeffs_flat):\n",
        "                details.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "                idx += length\n",
        "            else:\n",
        "                remaining = len(coeffs_flat) - idx\n",
        "                padded = np.zeros(length)\n",
        "                if remaining > 0:\n",
        "                    padded[:remaining] = coeffs_flat[idx:]\n",
        "                details.append(padded.reshape(size))\n",
        "                idx = len(coeffs_flat)\n",
        "        coeffs.insert(1, tuple(details))\n",
        "\n",
        "    result = pywt.waverec2(coeffs, wavelet)\n",
        "\n",
        "    # Redimensionner si nécessaire\n",
        "    if result.shape != original_shape and original_shape[0] > 256:\n",
        "        zoom_factors = (original_shape[0]/result.shape[0], original_shape[1]/result.shape[1])\n",
        "        result = zoom(result, zoom_factors, order=1)\n",
        "\n",
        "    return result\n",
        "\n",
        "def load_multiple_files_gdrive(folder_path, max_files=8):\n",
        "    \"\"\"Charge plusieurs fichiers .mat du dossier Google Drive\"\"\"\n",
        "    print(f\"🔍 Recherche de fichiers dans: {folder_path}\")\n",
        "\n",
        "    if not os.path.exists(folder_path):\n",
        "        print(f\"❌ Dossier inexistant: {folder_path}\")\n",
        "        return None\n",
        "\n",
        "    # Rechercher tous les fichiers .mat\n",
        "    mat_files = glob.glob(os.path.join(folder_path, \"*.mat\"))\n",
        "    print(f\"   📁 {len(mat_files)} fichiers .mat trouvés\")\n",
        "\n",
        "    if not mat_files:\n",
        "        print(\"❌ Aucun fichier .mat trouvé\")\n",
        "        return None\n",
        "\n",
        "    # Trier par nom (pour avoir un ordre temporel)\n",
        "    mat_files.sort()\n",
        "    mat_files = mat_files[:max_files]\n",
        "\n",
        "    print(f\"   📊 Chargement de {len(mat_files)} fichiers:\")\n",
        "    for f in mat_files:\n",
        "        print(f\"      - {os.path.basename(f)}\")\n",
        "\n",
        "    # Charger les données\n",
        "    time_series = []\n",
        "    metadata_list = []\n",
        "\n",
        "    for i, filepath in enumerate(mat_files):\n",
        "        try:\n",
        "            data = scipy.io.loadmat(filepath)\n",
        "\n",
        "            if 'w' in data:\n",
        "                w_field = data['w'].astype(np.float32)\n",
        "                time_series.append(w_field)\n",
        "\n",
        "                # Métadonnées\n",
        "                metadata = {\n",
        "                    'filename': os.path.basename(filepath),\n",
        "                    'index': i,\n",
        "                    'min_vorticity': float(w_field.min()),\n",
        "                    'max_vorticity': float(w_field.max()),\n",
        "                    'mean_vorticity': float(w_field.mean()),\n",
        "                    'std_vorticity': float(w_field.std()),\n",
        "                    'energy': float(np.sum(w_field**2))\n",
        "                }\n",
        "                metadata_list.append(metadata)\n",
        "\n",
        "                print(f\"   ✅ {os.path.basename(filepath)}: {w_field.shape} | \"\n",
        "                      f\"Énergie: {metadata['energy']:.2e}\")\n",
        "\n",
        "            else:\n",
        "                print(f\"   ⚠️  Pas de clé 'w' dans {os.path.basename(filepath)}\")\n",
        "                # Essayer d'autres clés\n",
        "                for key in data.keys():\n",
        "                    if not key.startswith('__') and isinstance(data[key], np.ndarray):\n",
        "                        if len(data[key].shape) == 2:\n",
        "                            w_field = data[key].astype(np.float32)\n",
        "                            time_series.append(w_field)\n",
        "                            print(f\"   ✅ Utilisé clé '{key}': {w_field.shape}\")\n",
        "                            break\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"   ❌ Erreur avec {os.path.basename(filepath)}: {e}\")\n",
        "\n",
        "    if time_series:\n",
        "        time_series = np.array(time_series, dtype=np.float32)\n",
        "        print(f\"\\n✅ Série temporelle chargée: {time_series.shape}\")\n",
        "        return {\n",
        "            'data': time_series,\n",
        "            'metadata': metadata_list,\n",
        "            'files': [os.path.basename(f) for f in mat_files[:len(time_series)]]\n",
        "        }\n",
        "    else:\n",
        "        return None\n",
        "\n",
        "def create_synthetic_evolution(time_series, additional_steps=4):\n",
        "    \"\"\"Ajoute des pas de temps synthétiques à la série existante\"\"\"\n",
        "    print(f\"🔄 Extension synthétique: +{additional_steps} pas de temps...\")\n",
        "\n",
        "    extended_series = list(time_series)\n",
        "    current_field = time_series[-1].copy()\n",
        "\n",
        "    for t in range(additional_steps):\n",
        "        # Évolution synthétique basée sur les derniers champs\n",
        "        if len(extended_series) >= 2:\n",
        "            # Extrapolation basée sur la tendance\n",
        "            trend = extended_series[-1] - extended_series[-2]\n",
        "            evolved_field = extended_series[-1] + 0.5 * trend\n",
        "        else:\n",
        "            evolved_field = current_field.copy()\n",
        "\n",
        "        # Ajout de bruit physique\n",
        "        noise = np.random.normal(0, 0.005 * np.std(evolved_field), evolved_field.shape)\n",
        "\n",
        "        # Rotation légère pour simuler l'évolution des tourbillons\n",
        "        rotated = rotate(evolved_field, angle=t*1.5, reshape=False, order=1)\n",
        "\n",
        "        # Combinaison\n",
        "        final_field = 0.9 * evolved_field + 0.1 * rotated + noise\n",
        "        extended_series.append(final_field.astype(np.float32))\n",
        "\n",
        "        current_field = final_field\n",
        "        print(f\"   Temps synthétique {t+1}/{additional_steps} généré\")\n",
        "\n",
        "    return np.array(extended_series)\n",
        "\n",
        "class AdvancedPINN(nn.Module):\n",
        "    \"\"\"Modèle PINN pour données multiples\"\"\"\n",
        "\n",
        "    def __init__(self, input_dim, hidden_dim=64):\n",
        "        super(AdvancedPINN, self).__init__()\n",
        "\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Linear(input_dim, hidden_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.1),\n",
        "        )\n",
        "\n",
        "        self.lstm = nn.LSTM(\n",
        "            input_size=hidden_dim,\n",
        "            hidden_size=hidden_dim,\n",
        "            num_layers=2,\n",
        "            batch_first=True,\n",
        "            dropout=0.1\n",
        "        )\n",
        "\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(hidden_dim, hidden_dim//2),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(hidden_dim//2, input_dim),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        batch_size, seq_len, input_dim = x.shape\n",
        "\n",
        "        # Encoder\n",
        "        encoded_sequence = []\n",
        "        for i in range(seq_len):\n",
        "            encoded = self.encoder(x[:, i, :])\n",
        "            encoded_sequence.append(encoded)\n",
        "\n",
        "        encoded_sequence = torch.stack(encoded_sequence, dim=1)\n",
        "\n",
        "        # LSTM\n",
        "        lstm_out, _ = self.lstm(encoded_sequence)\n",
        "        last_hidden = lstm_out[:, -1, :]\n",
        "\n",
        "        # Decoder\n",
        "        output = self.decoder(last_hidden)\n",
        "\n",
        "        return output.unsqueeze(1)\n",
        "\n",
