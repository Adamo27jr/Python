        "\n",
        "def create_synthetic_evolution(time_series, additional_steps=25):  # ✅ MODIFIÉ: 4 → 25\n",
        "    \"\"\"Ajoute des pas de temps synthétiques à la série existante\"\"\"\n",
        "    print(f\"🔄 Extension synthétique: +{additional_steps} pas de temps...\")\n",
        "\n",
        "    extended_series = list(time_series)\n",
        "    current_field = time_series[-1].copy()\n",
        "\n",
        "    for t in range(additional_steps):\n",
        "        # Évolution synthétique basée sur les derniers champs\n",
        "        if len(extended_series) >= 2:\n",
        "            # Extrapolation basée sur la tendance\n",
        "            trend = extended_series[-1] - extended_series[-2]\n",
        "            evolved_field = extended_series[-1] + 0.5 * trend\n",
        "        else:\n",
        "            evolved_field = current_field.copy()\n",
        "\n",
        "        # Ajout de bruit physique\n",
        "        noise = np.random.normal(0, 0.005 * np.std(evolved_field), evolved_field.shape)\n",
        "\n",
        "        # Rotation légère pour simuler l'évolution des tourbillons\n",
        "        rotated = rotate(evolved_field, angle=t*1.5, reshape=False, order=1)\n",
        "\n",
        "        # Combinaison\n",
        "        final_field = 0.9 * evolved_field + 0.1 * rotated + noise\n",
        "        extended_series.append(final_field.astype(np.float32))\n",
        "\n",
        "        current_field = final_field\n",
        "        print(f\"   Temps synthétique {t+1}/{additional_steps} généré\")\n",
        "\n",
        "    return np.array(extended_series)\n",
        "\n",
        "class AdvancedPINN(nn.Module):\n",
        "    \"\"\"Modèle PINN pour données multiples\"\"\"\n",
        "\n",
        "    def __init__(self, input_dim, hidden_dim=128):  # ✅ MODIFIÉ: 64 → 128\n",
        "        super(AdvancedPINN, self).__init__()\n",
        "\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Linear(input_dim, hidden_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.1),\n",
        "        )\n",
        "\n",
        "        self.lstm = nn.LSTM(\n",
        "            input_size=hidden_dim,\n",
        "            hidden_size=hidden_dim,\n",
        "            num_layers=3,  # ✅ MODIFIÉ: 2 → 3\n",
        "            batch_first=True,\n",
        "            dropout=0.1\n",
        "        )\n",
        "\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(hidden_dim, hidden_dim//2),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(hidden_dim//2, input_dim),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        batch_size, seq_len, input_dim = x.shape\n",
        "\n",
        "        # Encoder\n",
        "        encoded_sequence = []\n",
        "        for i in range(seq_len):\n",
        "            encoded = self.encoder(x[:, i, :])\n",
        "            encoded_sequence.append(encoded)\n",
        "\n",
        "        encoded_sequence = torch.stack(encoded_sequence, dim=1)\n",
        "\n",
        "        # LSTM\n",
        "        lstm_out, _ = self.lstm(encoded_sequence)\n",
        "        last_hidden = lstm_out[:, -1, :]\n",
        "\n",
        "        # Decoder\n",
        "        output = self.decoder(last_hidden)\n",
        "\n",
        "        return output.unsqueeze(1)\n",
        "\n",
