        "\n",
        "import numpy as np\n",
        "import scipy.io\n",
        "import pywt\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import matplotlib.pyplot as plt\n",
        "import os\n",
        "from scipy.ndimage import zoom, rotate\n",
        "import glob\n",
        "from google.colab import drive\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# Monter Google Drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "def dwt_transform_video(data, wavelet='coif2', levels=1):\n",
        "    \"\"\"Transformée en ondelettes pour vidéo\"\"\"\n",
        "    if data.shape[0] > 256:\n",
        "        h, w = data.shape\n",
        "        new_h, new_w = h//2, w//2\n",
        "        data_resized = np.zeros((new_h, new_w), dtype=np.float32)\n",
        "\n",
        "        for i in range(new_h):\n",
        "            for j in range(new_w):\n",
        "                data_resized[i, j] = np.mean(data[2*i:2*i+2, 2*j:2*j+2])\n",
        "        data = data_resized\n",
        "\n",
        "    coeffs = pywt.wavedec2(data, wavelet, level=levels)\n",
        "    coeffs_flat = []\n",
        "    for i, coeff in enumerate(coeffs):\n",
        "        if i == 0:\n",
        "            coeffs_flat.append(coeff.flatten())\n",
        "        else:\n",
        "            for detail in coeff:\n",
        "                coeffs_flat.append(detail.flatten())\n",
        "    return np.concatenate(coeffs_flat)\n",
        "\n",
        "def idwt_transform_video(coeffs_flat, original_shape, wavelet='coif2', levels=1):\n",
        "    \"\"\"Transformée inverse pour vidéo\"\"\"\n",
        "    if original_shape[0] > 256:\n",
        "        work_shape = (original_shape[0]//2, original_shape[1]//2)\n",
        "    else:\n",
        "        work_shape = original_shape\n",
        "\n",
        "    coeffs = []\n",
        "    idx = 0\n",
        "\n",
        "    # Calculer les tailles\n",
        "    sizes = []\n",
        "    current_shape = work_shape\n",
        "    for i in range(levels + 1):\n",
        "        sizes.append(current_shape)\n",
        "        if i < levels:\n",
        "            current_shape = tuple(s // 2 for s in current_shape)\n",
        "\n",
        "    # Approximation\n",
        "    size = sizes[-1]\n",
        "    length = size[0] * size[1]\n",
        "    coeffs.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "    idx += length\n",
        "\n",
        "    # Détails\n",
        "    for i in range(levels-1, -1, -1):\n",
        "        size = sizes[i+1] if i+1 < len(sizes) else sizes[-1]\n",
        "        length = size[0] * size[1]\n",
        "        details = []\n",
        "        for _ in range(3):\n",
        "            if idx + length <= len(coeffs_flat):\n",
        "                details.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "                idx += length\n",
        "            else:\n",
        "                remaining = len(coeffs_flat) - idx\n",
        "                padded = np.zeros(length)\n",
        "                if remaining > 0:\n",
        "                    padded[:remaining] = coeffs_flat[idx:]\n",
        "                details.append(padded.reshape(size))\n",
        "                idx = len(coeffs_flat)\n",
        "        coeffs.insert(1, tuple(details))\n",
        "\n",
        "    result = pywt.waverec2(coeffs, wavelet)\n",
        "\n",
        "    # Redimensionner si nécessaire\n",
        "    if result.shape != original_shape and original_shape[0] > 256:\n",
        "        zoom_factors = (original_shape[0]/result.shape[0], original_shape[1]/result.shape[1])\n",
        "        result = zoom(result, zoom_factors, order=1)\n",
        "\n",
        "    return result\n",
        "\n",
        "class VideoPINN(nn.Module):\n",
        "    \"\"\"Modèle PINN pour génération vidéo\"\"\"\n",
        "\n",
        "    def __init__(self, input_dim, hidden_dim=64):\n",
        "        super(VideoPINN, self).__init__()\n",
        "\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Linear(input_dim, hidden_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.1),\n",
        "        )\n",
        "\n",
        "        self.lstm = nn.LSTM(\n",
        "            input_size=hidden_dim,\n",
        "            hidden_size=hidden_dim,\n",
        "            num_layers=2,\n",
        "            batch_first=True,\n",
        "            dropout=0.1\n",
        "        )\n",
        "\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(hidden_dim, hidden_dim//2),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(hidden_dim//2, input_dim),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        batch_size, seq_len, input_dim = x.shape\n",
        "\n",
        "        # Encoder\n",
        "        encoded_sequence = []\n",
        "        for i in range(seq_len):\n",
        "            encoded = self.encoder(x[:, i, :])\n",
        "            encoded_sequence.append(encoded)\n",
        "\n",
        "        encoded_sequence = torch.stack(encoded_sequence, dim=1)\n",
        "\n",
        "        # LSTM\n",
        "        lstm_out, _ = self.lstm(encoded_sequence)\n",
        "        last_hidden = lstm_out[:, -1, :]\n",
        "\n",
        "        # Decoder\n",
        "        output = self.decoder(last_hidden)\n",
        "\n",
        "        return output.unsqueeze(1)\n",
        "\n",
        "def load_all_temporal_files(folder_path, max_files=20):\n",
        "    \"\"\"Charge tous les fichiers temporels pour la vidéo\"\"\"\n",
        "    print(f\"🎬 CHARGEMENT POUR VIDÉO COMPARATIVE\")\n",
        "    print(f\"📂 Dossier: {folder_path}\")\n",
        "\n",
        "    if not os.path.exists(folder_path):\n",
        "        print(f\"❌ Dossier inexistant: {folder_path}\")\n",
        "        return None\n",
        "\n",
        "    # Rechercher tous les fichiers .mat\n",
        "    mat_files = glob.glob(os.path.join(folder_path, \"*.mat\"))\n",
        "    print(f\"   📁 {len(mat_files)} fichiers .mat trouvés\")\n",
        "\n",
        "    if not mat_files:\n",
        "        print(\"❌ Aucun fichier .mat trouvé\")\n",
        "        return None\n",
        "\n",
        "    # Trier par numéro de temps (t0, t1, t2, ...)\n",
        "    def extract_time_number(filename):\n",
        "        try:\n",
        "            # Extraire le numéro après 't'\n",
        "            base = os.path.basename(filename)\n",
        "            time_part = base.split('_t')[1].split('.')[0]\n",
        "            return int(time_part)\n",
        "        except:\n",
        "            return 0\n",
        "\n",
        "    mat_files.sort(key=extract_time_number)\n",
        "    mat_files = mat_files[:max_files]\n",
        "\n",
        "    print(f\"   📊 Chargement de {len(mat_files)} fichiers temporels:\")\n",
        "\n",
        "    # Charger les données\n",
        "    time_series = []\n",
        "    time_indices = []\n",
        "\n",
        "    for i, filepath in enumerate(mat_files):\n",
        "        try:\n",
        "            data = scipy.io.loadmat(filepath)\n",
        "\n",
        "            if 'w' in data:\n",
        "                w_field = data['w'].astype(np.float32)\n",
        "                time_series.append(w_field)\n",
        "\n",
        "                # Extraire l'indice temporel\n",
        "                time_idx = extract_time_number(filepath)\n",
        "                time_indices.append(time_idx)\n",
        "\n",
        "                print(f\"   ✅ t{time_idx:2d}: {w_field.shape} | \"\n",
        "                      f\"Énergie: {np.sum(w_field**2):.2e}\")\n",
        "\n",
        "            else:\n",
        "                print(f\"   ⚠️  Pas de clé 'w' dans {os.path.basename(filepath)}\")\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"   ❌ Erreur avec {os.path.basename(filepath)}: {e}\")\n",
        "\n",
        "    if time_series:\n",
        "        time_series = np.array(time_series, dtype=np.float32)\n",
        "        print(f\"\\n✅ Série temporelle complète: {time_series.shape}\")\n",
        "        print(f\"   📈 Indices temporels: {min(time_indices)} → {max(time_indices)}\")\n",
        "        return {\n",
        "            'data': time_series,\n",
        "            'time_indices': time_indices,\n",
        "            'files': [os.path.basename(f) for f in mat_files[:len(time_series)]]\n",
        "        }\n",
        "    else:\n",
        "        return None\n",
        "\n",
        "def train_video_model(time_series, seq_len=3):\n",
        "    \"\"\"Entraîne le modèle pour la prédiction vidéo\"\"\"\n",
        "    print(f\"\\n🚀 ENTRAÎNEMENT MODÈLE VIDÉO\")\n",
        "\n",
        "    original_shape = time_series[0].shape\n",
        "\n",
        "    # Traitement ondelettes\n",
        "    print(\"🌊 Traitement ondelettes...\")\n",
        "    processed_series = []\n",
        "    for i, field in enumerate(time_series):\n",
        "        coeffs = dwt_transform_video(field, 'coif2', 1)\n",
        "        processed_series.append(coeffs.astype(np.float32))\n",
        "        if (i + 1) % 5 == 0:\n",
        "            print(f\"   Traité: {i+1}/{len(time_series)}\")\n",
        "\n",
        "    processed_series = np.array(processed_series, dtype=np.float32)\n",
        "    print(f\"   ✅ Coefficients: {processed_series.shape}\")\n",
        "\n",
        "    # Création des séquences\n",
        "    X, y = [], []\n",
        "    for i in range(len(processed_series) - seq_len):\n",
        "        X.append(processed_series[i:i+seq_len])\n",
        "        y.append(processed_series[i+seq_len:i+seq_len+1])\n",
        "\n",
        "    X = np.array(X, dtype=np.float32)\n",
        "    y = np.array(y, dtype=np.float32)\n",
        "\n",
        "    print(f\"   📝 Séquences: X={X.shape}, y={y.shape}\")\n",
        "\n",
        "    # Normalisation\n",
        "    X_mean, X_std = X.mean(), X.std()\n",
        "    X_norm = (X - X_mean) / (X_std + 1e-8)\n",
        "    y_norm = (y - X_mean) / (X_std + 1e-8)\n",
        "\n",
        "    # Modèle\n",
        "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "    model = VideoPINN(X.shape[-1], hidden_dim=64).to(device)\n",
        "\n",
        "    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n",
        "    criterion = nn.MSELoss()\n",
        "\n",
        "    print(f\"   🧠 Modèle: {sum(p.numel() for p in model.parameters()):,} paramètres\")\n",
        "    print(f\"   💻 Device: {device}\")\n",
        "\n",
        "    # Entraînement rapide\n",
        "    model.train()\n",
        "    epochs = 50\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        total_loss = 0\n",
        "\n",
        "        for i in range(len(X_norm)):\n",
        "            batch_X = torch.FloatTensor(X_norm[i:i+1]).to(device)\n",
        "            batch_y = torch.FloatTensor(y_norm[i:i+1]).to(device)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            pred = model(batch_X)\n",
        "            loss = criterion(pred, batch_y)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "            total_loss += loss.item()\n",
        "\n",
        "            del batch_X, batch_y, pred, loss\n",
        "\n",
        "        if (epoch + 1) % 10 == 0:\n",
        "            avg_loss = total_loss / len(X_norm)\n",
        "            print(f\"   Époque {epoch+1:2d}/{epochs} | Loss: {avg_loss:.6f}\")\n",
        "            torch.cuda.empty_cache()\n",
        "\n",
        "    return model, X_mean, X_std, original_shape, processed_series\n",
        "\n",
        "def generate_video_sequence(model, time_series, X_mean, X_std, original_shape,\n",
        "                          processed_series, seq_len=3, n_predictions=10):\n",
        "    \"\"\"Génère une séquence vidéo de prédictions\"\"\"\n",
        "    print(f\"\\n🎬 GÉNÉRATION SÉQUENCE VIDÉO\")\n",
        "\n",
        "    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "    model.eval()\n",
        "\n",
        "    # Utiliser les dernières séquences comme point de départ\n",
        "    seed_sequence = processed_series[-seq_len:]\n",
        "    seed_sequence = (seed_sequence - X_mean) / (X_std + 1e-8)\n",
        "\n",
        "    predictions = []\n",
        "    current_sequence = seed_sequence.copy()\n",
        "\n",
        "    print(f\"   🌱 Séquence initiale: {current_sequence.shape}\")\n",
        "    print(f\"   🔮 Génération de {n_predictions} prédictions...\")\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for i in range(n_predictions):\n",
        "            # Prédiction\n",
        "            input_tensor = torch.FloatTensor(current_sequence[np.newaxis, :, :]).to(device)\n",
        "            pred = model(input_tensor).cpu().numpy()\n",
        "\n",
        "            # Dénormaliser\n",
        "            pred_denorm = pred.flatten() * X_std + X_mean\n",
        "            predictions.append(pred_denorm)\n",
        "\n",
        "            # Mettre à jour la séquence (glissement)\n",
        "            current_sequence = np.roll(current_sequence, -1, axis=0)\n",
        "            current_sequence[-1] = pred.flatten()\n",
        "\n",
        "            print(f\"   ✅ Prédiction {i+1}/{n_predictions} générée\")\n",
        "\n",
        "    # Reconstruire les champs\n",
        "    print(\"   🔄 Reconstruction des champs...\")\n",
        "    predicted_fields = []\n",
        "\n",
        "    for i, pred_coeffs in enumerate(predictions):\n",
        "        try:\n",
        "            field = idwt_transform_video(pred_coeffs, original_shape, 'coif2', 1)\n",
        "            predicted_fields.append(field)\n",
        "        except Exception as e:\n",
        "            print(f\"   ⚠️  Erreur reconstruction {i}: {e}\")\n",
        "\n",
        "    predicted_fields = np.array(predicted_fields)\n",
        "    print(f\"   ✅ Champs prédits: {predicted_fields.shape}\")\n",
        "\n",
        "    return predicted_fields\n",
        "\n",
        "def create_video_snapshots(real_fields, predicted_fields, time_indices,\n",
        "                         output_dir=\"video_snapshots\"):\n",
        "    \"\"\"Crée les snapshots pour la vidéo comparative\"\"\"\n",
        "    print(f\"\\n📸 CRÉATION SNAPSHOTS VIDÉO\")\n",
        "\n",
        "    # Créer le dossier de sortie\n",
        "    os.makedirs(output_dir, exist_ok=True)\n",
        "    print(f\"   📁 Dossier: {output_dir}\")\n",
        "\n",
        "    # Déterminer les limites communes pour la colormap\n",
        "    all_data = np.concatenate([real_fields.flatten(), predicted_fields.flatten()])\n",
        "    vmin, vmax = np.percentile(all_data, [1, 99])\n",
        "\n",
        "    print(f\"   🎨 Limites colormaps: [{vmin:.3f}, {vmax:.3f}]\")\n",
        "\n",
        "    # Générer les snapshots\n",
        "    n_real = len(real_fields)\n",
        "    n_pred = len(predicted_fields)\n",
        "\n",
        "    # 1. Snapshots des champs réels\n",
        "    print(\"   📷 Snapshots champs réels...\")\n",
        "    for i in range(n_real):\n",
        "        fig, ax = plt.subplots(1, 1, figsize=(10, 8))\n",
        "\n",
        "        im = ax.imshow(real_fields[i], cmap='RdBu_r', vmin=vmin, vmax=vmax, aspect='auto')\n",
        "        ax.set_title(f'Champ Réel - Temps t{time_indices[i]:02d}\\n'\n",
