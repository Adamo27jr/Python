        "        ax.set_xlabel('x', fontsize=12)\n",
        "        ax.set_ylabel('y', fontsize=12)\n",
        "\n",
        "        cbar = plt.colorbar(im, ax=ax, shrink=0.8)\n",
        "        cbar.set_label('Vorticité', fontsize=12)\n",
        "\n",
        "        plt.tight_layout()\n",
        "        plt.savefig(f'{output_dir}/real_t{time_indices[i]:02d}.png', dpi=150, bbox_inches='tight')\n",
