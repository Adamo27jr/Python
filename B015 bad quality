        "\n",
        "    for i in range(n_pred):\n",
        "        fig, ax = plt.subplots(1, 1, figsize=(10, 8))\n",
        "\n",
        "        im = ax.imshow(predicted_fields[i], cmap='RdBu_r', vmin=vmin, vmax=vmax, aspect='auto')\n",
        "        ax.set_title(f'Prédiction PINN - Temps t{start_time + i:02d}\\n'\n",
        "                    f'Énergie: {np.sum(predicted_fields[i]**2):.2e}', fontsize=14)\n",
        "        ax.set_xlabel('x', fontsize=12)\n",
        "        ax.set_ylabel('y', fontsize=12)\n",
        "\n",
        "        cbar = plt.colorbar(im, ax=ax, shrink=0.8)\n",
        "        cbar.set_label('Vorticité', fontsize=12)\n",
        "\n",
        "        plt.tight_layout()\n",
        "        plt.savefig(f'{output_dir}/pred_t{start_time + i:02d}.png', dpi=150, bbox_inches='tight')\n",
        "        plt.close()\n",
        "\n",
        "        if (i + 1) % 5 == 0:\n",
        "            print(f\"      Prédictions: {i+1}/{n_pred}\")\n",
        "\n",
        "    # 3. Snapshots comparatifs (côte à côte)\n",
        "    print(\"   🔄 Snapshots comparatifs...\")\n",
        "    min_len = min(n_real, n_pred)\n",
        "\n",
        "    for i in range(min_len):\n",
        "        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(20, 8))\n",
        "\n",
        "        # Réel\n",
        "        im1 = ax1.imshow(real_fields[i], cmap='RdBu_r', vmin=vmin, vmax=vmax, aspect='auto')\n",
        "        ax1.set_title(f'RÉEL - t{time_indices[i]:02d}\\n'\n",
        "                     f'Énergie: {np.sum(real_fields[i]**2):.2e}', fontsize=14)\n",
        "        ax1.set_xlabel('x', fontsize=12)\n",
        "        ax1.set_ylabel('y', fontsize=12)\n",
        "        plt.colorbar(im1, ax=ax1, shrink=0.8)\n",
        "\n",
        "        # Prédiction\n",
        "        im2 = ax2.imshow(predicted_fields[i], cmap='RdBu_r', vmin=vmin, vmax=vmax, aspect='auto')\n",
        "        ax2.set_title(f'PRÉDICTION PINN - t{start_time + i:02d}\\n'\n",
        "                     f'Énergie: {np.sum(predicted_fields[i]**2):.2e}', fontsize=14)\n",
        "        ax2.set_xlabel('x', fontsize=12)\n",
        "        ax2.set_ylabel('y', fontsize=12)\n",
        "        plt.colorbar(im2, ax=ax2, shrink=0.8)\n",
        "\n",
        "        plt.tight_layout()\n",
        "        plt.savefig(f'{output_dir}/compare_t{time_indices[i]:02d}.png', dpi=150, bbox_inches='tight')\n",
        "        plt.close()\n",
        "\n",
        "        if (i + 1) % 3 == 0:\n",
        "            print(f\"      Comparatifs: {i+1}/{min_len}\")\n",
        "\n",
        "    # 4. Résumé des fichiers générés\n",
        "    generated_files = os.listdir(output_dir)\n",
        "    png_files = [f for f in generated_files if f.endswith('.png')]\n",
        "\n",
        "    print(f\"\\n✅ SNAPSHOTS GÉNÉRÉS:\")\n",
        "    print(f\"   📁 Dossier: {output_dir}\")\n",
