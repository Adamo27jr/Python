        "\n",
        "# ========== AMÉLIORATIONS POUR LA PRÉCISION ==========\n",
        "\n",
        "def test_wavelets_performance(data_sample):\n",
        "    \"\"\"Teste différentes ondelettes pour choisir la meilleure\"\"\"\n",
        "    wavelets_to_test = [\n",
        "        'coif2', 'coif4', 'coif6',      # Coiflets (différents ordres)\n",
        "        'db4', 'db6', 'db8',           # Daubechies\n",
        "        'bior2.2', 'bior4.4',          # Biorthogonales\n",
