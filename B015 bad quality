        "def calculate_psnr(img1, img2, max_val=None):\n",
        "    \"\"\"Calcule le PSNR entre deux images\"\"\"\n",
        "    if max_val is None:\n",
        "        max_val = max(img1.max(), img2.max()) - min(img1.min(), img2.min())\n",
        "\n",
        "    mse = np.mean((img1 - img2) ** 2)\n",
        "    if mse == 0:\n",
        "        return float('inf')\n",
        "\n",
        "    psnr = 20 * np.log10(max_val / np.sqrt(mse))\n",
        "    return psnr\n",
        "\n",
        "def calculate_ssim_simple(img1, img2):\n",
        "    \"\"\"Version simplifiée du SSIM\"\"\"\n",
        "    mu1 = np.mean(img1)\n",
        "    mu2 = np.mean(img2)\n",
        "\n",
        "    sigma1_sq = np.var(img1)\n",
        "    sigma2_sq = np.var(img2)\n",
        "    sigma12 = np.mean((img1 - mu1) * (img2 - mu2))\n",
        "\n",
        "    c1 = 0.01 ** 2\n",
        "    c2 = 0.03 ** 2\n",
        "\n",
        "    ssim = ((2 * mu1 * mu2 + c1) * (2 * sigma12 + c2)) / \\\n",
        "           ((mu1**2 + mu2**2 + c1) * (sigma1_sq + sigma2_sq + c2))\n",
        "\n",
        "    return ssim\n",
        "\n",
        "def dwt_transform_gdrive(data, wavelet='coif2', levels=1):\n",
        "    \"\"\"Transformée en ondelettes optimisée\"\"\"\n",
        "    if data.shape[0] > 256:\n",
        "        # Sous-échantillonnage par moyennage\n",
        "        h, w = data.shape\n",
        "        new_h, new_w = h//2, w//2\n",
        "        data_resized = np.zeros((new_h, new_w), dtype=np.float32)\n",
        "\n",
        "        for i in range(new_h):\n",
        "            for j in range(new_w):\n",
        "                data_resized[i, j] = np.mean(data[2*i:2*i+2, 2*j:2*j+2])\n",
        "\n",
        "        data = data_resized\n",
        "\n",
        "    coeffs = pywt.wavedec2(data, wavelet, level=levels)\n",
        "    coeffs_flat = []\n",
        "    for i, coeff in enumerate(coeffs):\n",
        "        if i == 0:\n",
        "            coeffs_flat.append(coeff.flatten())\n",
        "        else:\n",
        "            for detail in coeff:\n",
        "                coeffs_flat.append(detail.flatten())\n",
        "    return np.concatenate(coeffs_flat)\n",
        "\n",
        "def idwt_transform_gdrive(coeffs_flat, original_shape, wavelet='coif2', levels=1):\n",
        "    \"\"\"Transformée inverse optimisée\"\"\"\n",
        "    if original_shape[0] > 256:\n",
        "        work_shape = (original_shape[0]//2, original_shape[1]//2)\n",
        "    else:\n",
        "        work_shape = original_shape\n",
        "\n",
        "    coeffs = []\n",
        "    idx = 0\n",
        "\n",
        "    # Calculer les tailles\n",
        "    sizes = []\n",
        "    current_shape = work_shape\n",
        "    for i in range(levels + 1):\n",
        "        sizes.append(current_shape)\n",
        "        if i < levels:\n",
        "            current_shape = tuple(s // 2 for s in current_shape)\n",
        "\n",
        "    # Approximation\n",
        "    size = sizes[-1]\n",
        "    length = size[0] * size[1]\n",
        "    coeffs.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "    idx += length\n",
        "\n",
        "    # Détails\n",
        "    for i in range(levels-1, -1, -1):\n",
        "        size = sizes[i+1] if i+1 < len(sizes) else sizes[-1]\n",
        "        length = size[0] * size[1]\n",
        "        details = []\n",
        "        for _ in range(3):\n",
        "            if idx + length <= len(coeffs_flat):\n",
        "                details.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "                idx += length\n",
        "            else:\n",
        "                remaining = len(coeffs_flat) - idx\n",
        "                padded = np.zeros(length)\n",
        "                if remaining > 0:\n",
        "                    padded[:remaining] = coeffs_flat[idx:]\n",
        "                details.append(padded.reshape(size))\n",
        "                idx = len(coeffs_flat)\n",
