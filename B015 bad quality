        "\n",
        "    return best_wavelet, results\n",
        "\n",
        "def adaptive_dwt_transform(data, wavelet='auto', levels='auto'):\n",
        "    \"\"\"Transformée ondelettes adaptative améliorée\"\"\"\n",
        "\n",
        "    # Auto-sélection de l'ondelette\n",
        "    if wavelet == 'auto':\n",
        "        wavelet, _ = test_wavelets_performance(data)\n",
        "\n",
        "    # Auto-sélection du nombre de niveaux\n",
        "    if levels == 'auto':\n",
        "        # Basé sur la taille de l'image\n",
        "        min_dim = min(data.shape)\n",
        "        levels = min(4, int(np.log2(min_dim)) - 2)  # Maximum 4 niveaux\n",
        "        print(f\"🔧 Niveaux auto: {levels}\")\n",
        "\n",
        "    # Prétraitement adaptatif\n",
        "    if data.shape[0] > 256:\n",
        "        # Sous-échantillonnage intelligent avec filtre anti-aliasing\n",
        "        from scipy.ndimage import gaussian_filter\n",
        "\n",
        "        # Filtre anti-aliasing\n",
        "        sigma = 0.5  # Paramètre du filtre gaussien\n",
        "        filtered_data = gaussian_filter(data, sigma=sigma)\n",
        "\n",
        "        # Sous-échantillonnage par moyennage pondéré\n",
        "        h, w = data.shape\n",
        "        new_h, new_w = h//2, w//2\n",
        "        data_resized = np.zeros((new_h, new_w), dtype=np.float32)\n",
        "\n",
        "        # Moyennage avec poids gaussiens\n",
        "        weights = np.array([[0.25, 0.25], [0.25, 0.25]])  # Poids uniformes\n",
        "\n",
        "        for i in range(new_h):\n",
        "            for j in range(new_w):\n",
        "                region = filtered_data[2*i:2*i+2, 2*j:2*j+2]\n",
        "                data_resized[i, j] = np.sum(region * weights)\n",
        "\n",
        "        data = data_resized\n",
        "\n",
        "    # Décomposition multi-niveaux\n",
        "    coeffs = pywt.wavedec2(data, wavelet, level=levels)\n",
        "\n",
        "    # Aplatissement optimisé avec préservation de l'information\n",
        "    coeffs_flat = []\n",
        "    for i, coeff in enumerate(coeffs):\n",
        "        if i == 0:  # Approximation\n",
        "            coeffs_flat.append(coeff.flatten())\n",
        "        else:  # Détails\n",
        "            for detail in coeff:\n",
        "                coeffs_flat.append(detail.flatten())\n",
        "\n",
        "    return np.concatenate(coeffs_flat), wavelet, levels\n",
        "\n",
        "def adaptive_idwt_transform(coeffs_flat, original_shape, wavelet, levels):\n",
        "    \"\"\"Reconstruction adaptative améliorée\"\"\"\n",
        "\n",
        "    if original_shape[0] > 256:\n",
        "        work_shape = (original_shape[0]//2, original_shape[1]//2)\n",
        "    else:\n",
        "        work_shape = original_shape\n",
        "\n",
        "    # Reconstruction des coefficients\n",
        "    coeffs = []\n",
        "    idx = 0\n",
        "\n",
        "    # Calculer les tailles pour chaque niveau\n",
        "    sizes = []\n",
        "    current_shape = work_shape\n",
        "    for i in range(levels + 1):\n",
        "        sizes.append(current_shape)\n",
        "        if i < levels:\n",
        "            current_shape = tuple(s // 2 for s in current_shape)\n",
        "\n",
        "    # Approximation (niveau le plus grossier)\n",
        "    size = sizes[-1]\n",
        "    length = size[0] * size[1]\n",
        "    coeffs.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "    idx += length\n",
        "\n",
        "    # Détails (du plus grossier au plus fin)\n",
        "    for i in range(levels-1, -1, -1):\n",
        "        size = sizes[i+1] if i+1 < len(sizes) else sizes[-1]\n",
        "        length = size[0] * size[1]\n",
        "        details = []\n",
        "        for _ in range(3):  # H, V, D\n",
        "            if idx + length <= len(coeffs_flat):\n",
        "                details.append(coeffs_flat[idx:idx+length].reshape(size))\n",
        "                idx += length\n",
        "            else:\n",
