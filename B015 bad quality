        "        result = zoom(result, zoom_factors, order=3)  # Ordre 3 = bicubique\n",
        "\n",
        "    return result\n",
        "\n",
        "class UltraPrecisionPINN(nn.Module):\n",
        "    \"\"\"Modèle PINN ultra-précis avec améliorations architecturales\"\"\"\n",
        "\n",
        "    def __init__(self, input_dim, hidden_dim=256):  # ✅ NOUVEAU: 128 → 256\n",
        "        super(UltraPrecisionPINN, self).__init__()\n",
        "\n",
        "        # Encodeur multi-échelles\n",
        "        self.encoder_scales = nn.ModuleList([\n",
        "            nn.Sequential(\n",
        "                nn.Linear(input_dim, hidden_dim//4),\n",
        "                nn.ReLU(),\n",
        "                nn.Dropout(0.1)\n",
        "            ),\n",
        "            nn.Sequential(\n",
        "                nn.Linear(input_dim, hidden_dim//2),\n",
        "                nn.ReLU(),\n",
        "                nn.Dropout(0.1)\n",
        "            ),\n",
        "            nn.Sequential(\n",
        "                nn.Linear(input_dim, hidden_dim),\n",
        "                nn.ReLU(),\n",
        "                nn.Dropout(0.1)\n",
        "            )\n",
        "        ])\n",
        "\n",
        "        # Fusion des échelles\n",
        "        fusion_dim = hidden_dim//4 + hidden_dim//2 + hidden_dim\n",
        "        self.scale_fusion = nn.Sequential(\n",
        "            nn.Linear(fusion_dim, hidden_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.1)\n",
        "        )\n",
        "\n",
        "        # LSTM bidirectionnel avec plus de couches\n",
        "        self.lstm = nn.LSTM(\n",
        "            input_size=hidden_dim,\n",
        "            hidden_size=hidden_dim,\n",
        "            num_layers=4,  # ✅ NOUVEAU: 3 → 4\n",
        "            batch_first=True,\n",
        "            dropout=0.15,\n",
        "            bidirectional=True  # ✅ NOUVEAU: Bidirectionnel\n",
        "        )\n",
        "\n",
        "        # Attention mechanism\n",
        "        self.attention = nn.MultiheadAttention(\n",
        "            embed_dim=hidden_dim*2,  # *2 car bidirectionnel\n",
        "            num_heads=8,\n",
        "            dropout=0.1\n",
        "        )\n",
        "\n",
        "        # Décodeur avec connexions résiduelles\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.Linear(hidden_dim*2, hidden_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.1),\n",
        "            nn.Linear(hidden_dim, hidden_dim//2),\n",
        "            nn.ReLU(),\n",
        "            nn.Linear(hidden_dim//2, input_dim)\n",
        "        )\n",
        "\n",
        "        # Connexion résiduelle\n",
        "        self.residual_connection = nn.Linear(input_dim, input_dim)\n",
        "\n",
        "    def forward(self, x):\n",
        "        batch_size, seq_len, input_dim = x.shape\n",
        "\n",
        "        # Encodage multi-échelles\n",
        "        encoded_sequences = []\n",
        "        for i in range(seq_len):\n",
        "            scale_features = []\n",
        "            for encoder in self.encoder_scales:\n",
        "                scale_features.append(encoder(x[:, i, :]))\n",
        "\n",
        "            # Fusion des échelles\n",
        "            fused = torch.cat(scale_features, dim=1)\n",
        "            encoded = self.scale_fusion(fused)\n",
        "            encoded_sequences.append(encoded)\n",
        "\n",
        "        encoded_sequence = torch.stack(encoded_sequences, dim=1)\n",
        "\n",
        "        # LSTM bidirectionnel\n",
        "        lstm_out, _ = self.lstm(encoded_sequence)\n",
        "\n",
        "        # Attention sur la séquence\n",
        "        # Reshape pour attention: (seq_len, batch, features)\n",
        "        lstm_out_transposed = lstm_out.transpose(0, 1)\n",
        "        attended, _ = self.attention(\n",
        "            lstm_out_transposed,\n",
        "            lstm_out_transposed,\n",
        "            lstm_out_transposed\n",
        "        )\n",
        "\n",
        "        # Prendre la dernière sortie\n",
        "        last_hidden = attended[-1]  # (batch, features)\n",
        "\n",
        "        # Décodage\n",
        "        decoded = self.decoder(last_hidden)\n",
        "\n",
        "        # Connexion résiduelle avec la dernière entrée\n",
        "        residual = self.residual_connection(x[:, -1, :])\n",
        "        output = decoded + 0.1 * residual  # Connexion résiduelle pondérée\n",
        "\n",
        "        return output.unsqueeze(1)\n",
        "\n",
        "def advanced_loss_function(pred, target, physics_weight=0.1):\n",
        "    \"\"\"Fonction de perte avancée avec contraintes physiques\"\"\"\n",
        "\n",
        "    # Perte MSE standard\n",
        "    mse_loss = nn.MSELoss()(pred, target)\n",
        "\n",
        "    # Contrainte de conservation d'énergie\n",
        "    pred_energy = torch.sum(pred**2, dim=-1)\n",
        "    target_energy = torch.sum(target**2, dim=-1)\n",
        "    energy_loss = nn.MSELoss()(pred_energy, target_energy)\n",
        "\n",
        "    # Contrainte de régularité spatiale (approximation)\n",
        "    # Encourage la continuité spatiale\n",
        "    pred_flat = pred.view(pred.shape[0], -1)\n",
        "    target_flat = target.view(target.shape[0], -1)\n",
        "\n",
        "    # Différences finies approximatives\n",
        "    pred_diff = pred_flat[:, 1:] - pred_flat[:, :-1]\n",
        "    target_diff = target_flat[:, 1:] - target_flat[:, :-1]\n",
        "    smoothness_loss = nn.MSELoss()(pred_diff, target_diff)\n",
        "\n",
        "    # Perte totale\n",
        "    total_loss = mse_loss + physics_weight * (energy_loss + 0.1 * smoothness_loss)\n",
        "\n",
